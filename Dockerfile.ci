# CI/build image for quip-miner-cuda: the CUDA 12.9 toolchain the crate is
# pinned to (Cargo.toml cuda-12090), plus rustup. The toolchain version comes
# from rust-toolchain.toml at first cargo invocation, so this image does not
# pin rust itself.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PATH="/root/.cargo/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
       | sh -s -- -y --profile minimal --default-toolchain none
WORKDIR /src
